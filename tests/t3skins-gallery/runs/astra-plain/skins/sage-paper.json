  "css": "/* --info has no theme role and paints links and the \"Working\" status. Keep it a muted steel blue,\n   apart from the green --success of \"Done\", and paint links in the sage accent instead. */\n:root:not(.dark) { --info: #3d7896 !important; --info-foreground: #2f6680 !important; }\n.dark { --info: #93b9cc !important; --info-foreground: #93b9cc !important; }\n:root:not(.dark) :is(.chat-markdown, [data-user-message-bubble]) a:not(.chat-markdown-file-link) { color: #2f6f57 !important; }\n.dark :is(.chat-markdown, [data-user-message-bubble]) a:not(.chat-markdown-file-link) { color: #9fc7b8 !important; }\n:root:not(.dark) ::selection { background: #cfe3d7; color: #1f2421; }\n.dark ::selection { background: #2f4a40; color: #e3e2da; }"
